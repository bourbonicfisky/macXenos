{
  "_comment": [
    "What macXenos redistributes and the notices it carries (System > About >",
    "Acknowledgements). tools/build/collect_licenses.py turns this into",
    "acknowledgements.json beside the Preferences page. Each entry's files are",
    "repo paths (optionally a 'lines' [first, last] range of a source header that",
    "holds the license, or 'rtf' to convert), 'homebrew:<formula>/<file>' or",
    "'sparkle:<file>'. 'libs' are the third-party static libraries and dylibs",
    "the entry accounts for: the collector fails if the app links one that no",
    "entry names."
  ],
  "components": [
    {
      "name": "Xenia",
      "license": "BSD-3-Clause",
      "url": "https://github.com/xenia-canary/xenia-canary",
      "note": "macXenos is a macOS port of Xenia Canary.",
      "files": [{ "path": "LICENSE" }]
    },
    {
      "name": "FFmpeg",
      "license": "LGPL-2.1-or-later",
      "url": "https://ffmpeg.org",
      "note": "libavcodec, libavformat and libavutil, built from source in third_party/FFmpeg without GPL parts.",
      "libs": ["liblibavcodec.a", "liblibavformat.a", "liblibavutil.a"],
      "files": [{ "path": "third_party/FFmpeg/LICENSE.md" }, { "path": "third_party/FFmpeg/COPYING.LGPLv2.1" }]
    },
    {
      "name": "SDL2",
