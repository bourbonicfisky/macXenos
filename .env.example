# Signing / notarization config for tools/build/package_mac.sh.
# Copy to .env (gitignored) and fill in. None of these are committed.

# Developer ID Application identity, exactly as shown by:
#   security find-identity -v -p codesigning
# e.g. "Developer ID Application: Your Name (TEAMID1234)"
APPLE_SIGNING_IDENTITY=

# Apple Developer Team ID (10 chars), e.g. TEAMID1234
APPLE_TEAM_ID=

# --- Notarization only (NOT used unless package_mac.sh is run with --notarize) ---
# Apple ID email used for notarytool.
APPLE_ID=
# App-specific password for that Apple ID (appleid.apple.com -> App-Specific Passwords).
APPLE_PASSWORD=
