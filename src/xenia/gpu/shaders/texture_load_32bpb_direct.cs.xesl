// C1T G0 (task/metal-direct-texture-load-g0): narrow RGBA8-only variant of
// texture_load_32bpb that writes DIRECTLY into an ordinary (optimally tiled)
// 2D image instead of a linear byte buffer. It REUSES the shared source-side
// semantic logic verbatim — XeTextureLoadGetInfo, XeTextureLoadSourceAddress,
// XeEndianSwap32 from texture_load.xesli — and stores through the existing
// single-source image primitive image_store_2d_rgba_xe. The ONLY
// variant-specific code is the destination binding, the texel-coordinate
// store, and the raw-byte -> unorm float4 store convention (RGBA8Unorm
// .write() takes a normalized float4). No guest tiled-address or endian math
// is duplicated.
//
// 6.1-G0 (task/metal-texture-load-mip-tail-g0): to load an individual mip
// level directly into a level-scoped Metal texture view, the dispatch binds
// that view (its mip 0 aliases host mip N) and passes the level's own
// guest_offset/pitch/size — no shader change needed for non-packed levels
// (read position == write position). A PACKED mip-tail sub-mip, however,
// shares the tail's byte base but sits at a non-additive sub-tile (px,py)
// block offset within it (texture_util::GetPackedMipOffset), so the source
// READ position must be decoupled from the destination WRITE position. That
// (px,py) block offset is carried in the direct variant's otherwise-UNUSED
// host_offset push-constant field (px in the low 16 bits, py in the high 16),
// so the shared texture_load push-constant struct and the whole load-shader
// family ABI are UNCHANGED. host_offset == 0 (base and every non-packed
// level, and the existing C1T-R production route) gives read == write and is
// byte-identical to the pre-6.1 shader. The offset feeds the existing
// XeTextureLoadSourceAddress; no tiled/packing math is duplicated here.

#include "texture_load.xesli"

// Destination is a write-only RGBA8 2D image (Metal: texture2d<..,write>),
// declared inline in the bindings block exactly as apply_gamma_table's
// compute path does. The source byte buffer keeps its existing declaration
// and binding, so XeTextureLoadInfo is unchanged.
byte_buffer_align16_declare_xe(xe_texture_load_source, set=1, binding=0, t0,
                               space0)
entry_bindings_begin_compute_xe
  XE_TEXTURE_LOAD_PUSH_CONST_BINDING
  entry_binding_next_xe
  image_wo_xe(image_2d_xe, image_format_rgba8_xe, xe_texture_load_dest,
              set=0, binding=0, u0, space0, texture(1))
  entry_binding_next_xe
  byte_buffer_binding_xe(xe_texture_load_source, buffer(2))
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
{
  // 1 thread = 8 texels along X in one row (same thread contract as the
  // buffer 32bpb shader). block == texel for 32bpb.
  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(3u, 0u, 0u);
  dont_flatten_xe
  if (any(greater_than_equal_xe(block_index.xy, load_info.size_blocks.xy))) {
    return;
  }
  // Source READ position: the destination block plus the packed sub-mip
  // sub-tile offset (host_offset low/high 16 bits; 0 for base/non-packed and
  // the production route, giving read == write). The (px,py) can be non-8-
  // aligned (a 4x4 packed mip sits at x_blocks==4), so the second 4-texel
  // group's address is recomputed from scratch through the shared
  // XeTextureLoadSourceAddress rather than via the 8-aligned LocalXAddressXor
  // step the buffer shader uses — the full computation is correct for any x
  // and is byte-identical to the XOR step when the offset is 0.
  uint3_xe src_read = block_index + uint3_xe(load_info.host_offset & 0xFFFFu,
                                             load_info.host_offset >> 16u, 0u);
  // First 4 texels (x .. x+3).
  uint4_xe g0 = XeEndianSwap32(
      byte_buffer_align16_load16_xe(
          xe_texture_load_source,
          XeTextureLoadSourceAddress(load_info, src_read, 2u)),
      load_info.endian_32);
  // Second 4 texels (x+4 .. x+7).
  uint4_xe g1 = XeEndianSwap32(
      byte_buffer_align16_load16_xe(
          xe_texture_load_source,
          XeTextureLoadSourceAddress(load_info, src_read + uint3_xe(4u, 0u, 0u),
                                     2u)),
      load_info.endian_32);
  // Store convention only: each guest word holds one texel's RGBA8 bytes in
  // little-endian channel order (byte0=R..byte3=A); an RGBA8Unorm write takes
  // the normalized float4, so unpack bytes and divide by 255. This produces
  // the identical texture content the buffer+blit path would, because the
  // blit interprets those same raw bytes as RGBA8Unorm.
  uint gw[8];
  gw[0] = g0.x; gw[1] = g0.y; gw[2] = g0.z; gw[3] = g0.w;
  gw[4] = g1.x; gw[5] = g1.y; gw[6] = g1.z; gw[7] = g1.w;
  for (uint k = 0u; k < 8u; ++k) {
    uint x = block_index.x + k;
    if (x >= load_info.size_blocks.x) {
      continue;
    }
    uint w = gw[k];
    float4_xe texel = float4_xe(float(w & 0xFFu), float((w >> 8u) & 0xFFu),
                                float((w >> 16u) & 0xFFu),
                                float((w >> 24u) & 0xFFu)) *
                      (1.0f / 255.0f);
    image_store_2d_rgba_xe(xe_texture_load_dest,
                           uint2_xe(x, block_index.y), texel);
  }
}
entry_code_end_compute_xe
