{
  "name": "macxenos-blades",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The in-app Preferences, as Xbox 360 dashboard blades. Built into dist/ and bundled beside the binary as blades/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:cvars": "python3 tools/gen-mock-cvars.py ../.. src/mock-cvars.json",
    "check": "node tools/check.mjs",
    "test": "node tests/smoke.mjs",
    "screens": "node tests/screens.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.11",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
